App(
    appid="tetris",
    name="Tetris Clock",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tetris_app",
    # The frame buffer and the instance live on the heap; the stack carries the
    # event loop, one LocalTime and the renderer's locals. The cover solver
    # recurses at most 15 deep, once, at start.
    stack_size=4 * 1024,
    # "Examples" keeps this out of the firmware image - see applications/external/life.
    fap_category="Examples",
    fap_filename="Tetris",
    fap_version=(1, 0),
    fap_icon="tetris_10x10.png",
    # Bundled into the .fap and extracted to /ext/apps_assets/<fap_filename>/,
    # which is what gives dialog_set_icon() a path to this app's own icon.
    fap_file_assets="assets",
    sources=["tetris.c", "tetris_render.c"],
    targets=["f22"],
)
